	keywords = {Downlink, Delays, Internet of Things, DECT-2020 NR, ITU, IoT, Routing, ETSI, Printing, Technology, Mesh networks, Floods, massive mesh networks, selective flooding, selective source routing},
	pages = {1224--1230},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/U2DB8MAN/Alam et al. - 2026 - DL Routing Performance in DECT-2020 NR Massive Mesh Networks.pdf:application/pdf},
}

@inproceedings{graf_pareto_2026,
	title = {A {Pareto} {Optimality} {Approach} for {Link} {Adaptation} in {DECT} {NR}+},
	issn = {1558-2612},
	url = {https://ieeexplore.ieee.org/document/11555760/},
	doi = {10.1109/WCNC65185.2026.11555760},
	abstract = {DECT NR+ is a novel wireless IoT standard operating in the 1.9 GHz band, a band originally reserved for Digital Enhanced Cordless Telecommunications (DECT). This technology is also announced as the first non-cellular 5 G standard and theoretically offers wide flexibility in its application, ranging from Wireless Personal Area Network (WPAN) to Wide Area Network (WAN) scenarios. While this versatility is enabled by a wide range of configurable parameters, the practical application range is determined by the vendor's specific implementation. In this article, we investigate the impact of adjusting Modulation and Coding Scheme (MCS), transmit power and packet length. We formulate objective functions for data rate, energy consumption, and Packet Delivery Ratio (PDR), and analyze their dependence on the aforementioned parameters. To model specific relationships, we conduct practical experiments in two real-world testbeds using hardware from the Nordic nRF91 series. Finally, we present an approach for parameter selection based on the principle of Pareto optimality.},
	urldate = {2026-07-09},
	booktitle = {2026 {IEEE} {Wireless} {Communications} and {Networking} {Conference} ({WCNC})},
	author = {Graf, Fabian and Villnow, Michael and Watteyne, Thomas},
