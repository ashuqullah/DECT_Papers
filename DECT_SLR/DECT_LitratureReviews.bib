	month = feb,
	year = {2024},
	keywords = {Delays, Ultra reliable low latency communication, URLLC, Telecommunication traffic, Robustness, Wireless mesh networks, Critical infrastructure, low-latency, reliable communications, Smart grids, wireless mesh networks},
	pages = {100--105},
	file = {PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/ED2QW6ZW/Biswas et al. - 2024 - Reliable and Low-Latency Communications for Critical Infrastructures Utilizing Wireless Mesh Network.pdf:application/pdf;PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/NWBVSV29/Biswas et al. - 2024 - Reliable and Low-Latency Communications for Critical Infrastructures Utilizing Wireless Mesh Network.pdf:application/pdf},
