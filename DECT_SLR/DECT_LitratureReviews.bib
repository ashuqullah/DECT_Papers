@inproceedings{rauwolf_topology-aware_2026,
	title = {Topology-{Aware} {Deep} {Reinforcement} {Learning} for {Multi}-{Hop} {URLLC} in {DECT}-2020 {NR} {Mesh} {Networks}},
	issn = {2575-4912},
	url = {https://ieeexplore.ieee.org/document/11577203/},
	doi = {10.1109/EuCNC/6GSummit68295.2026.11577203},
	abstract = {DECT-2020 New Radio (NR) is a radio interface technology (RIT) standardized by the European Telecommunications Standards Institute (ETSI) for large-scale massive machine-type communication (mMTC) and Ultra-Reliable and Low-Latency Communications (URLLC) deployments. In DECT2020 NR mesh networks, multi-hop delivery is typically realized by flooding-based forwarding, which is robust but increases network load and does not explicitly optimize end-to-end latency or reliability. In this paper, we propose a topology-aware Deep Reinforcement Learning (DRL) framework for URLLC-oriented multi-hop routing in DECT-2020 NR mesh networks. Nexthop selection is modeled as a Markov decision process (MDP) whose state combines link-level latency and packet error rate (PER) metrics with graph-structured topology information. An inductive graph neural network (GNN) encoder summarizes the current mesh topology and a per-edge Deep Q-Network (DQN) head selects the next hop using a URLLC-shaped reward that jointly captures end-to-end latency and reliability. To improve scalability, the agent is trained through a curriculum over progressively larger topologies. Simulation results over small to large mesh topologies show that the proposed GNN+DRL routing policy improves the URLLC trade-off compared with both the existing latency-only routing method and the DECT2020 NR flooding procedure. For a representative medium-sized mesh network, it reduces end-to-end latency by up to 19.9 \%, lowers end-to-end PER by up to 10 \%, and decreases the number of transmissions per delivered packet compared with the existing approach.},
	urldate = {2026-07-09},
	booktitle = {2026 {Joint} {European} {Conference} on {Networks} and {Communications} \& {6G} {Summit} ({EuCNC}/{6G} {Summit})},
	author = {Rauwolf, Benjamin and Asif, Awais Bin and Peissig, Jürgen},
	month = jun,
	year = {2026},
	note = {ISSN: 2575-4912},
	keywords = {Topology, Ultra reliable low latency communication, URLLC, Timing, DECT-2020 NR, Routing, ETSI, Modeling, Printing, Joining processes, deep reinforcement learning, Equations, graph neural networks, Graph neural networks, mesh networks, routing},
	pages = {140--147},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/L9C7MFB8/Rauwolf et al. - 2026 - Topology-Aware Deep Reinforcement Learning for Multi-Hop URLLC in DECT-2020 NR Mesh Networks.pdf:application/pdf},
}

