	abstract = {The rapid growth of smartphones, laptops, and Internet of Things (IoT) devices has created an increasing demand for seamless, secure, and energy-efficient wireless direct communication. Current popular solutions, such as AirDrop and Intel Unison, rely on bluetooth low energy (BLE) for device discovery and pairing, alongside IEEE 802.11 (Wi-Fi) for high-speed data transmission. However, research has identified significant vulnerabilities in BLE, including information leakage and profile manipulation. To address these challenges, we propose an enhanced wireless direct connectivity (EWDC) framework that integrates digital enhanced cordless telecommunications (DECT)-2020 new radio (NR) with Wi-Fi. In this framework, DECT replaces BLE to enable secure and efficient device discovery, while Wi-Fi supports high-bandwidth data transmission. Specifically, DECT utilizes its licensed spectrum to establish a secure communication channel for sharing Wi-Fi configuration information, enabling a secure and reliable setup of high-speed Wi-Fi data transmission links between devices. To validate this approach, we implemented the DECT medium access control layer on the Nordic nRF9161-DK platform and evaluated the end-to-end delay between two devices. Our results demonstrate an impressive transmission delay of less than 1 {\textbackslash}mu s for EWDC communication, enabling rapid device discovery and highly efficient operation. Furthermore, to enhance the security of wireless direct connections, the WireGuard, a VPN tunnel, is employed to encrypt data transmission over Wi-Fi providing robust protection for data shared on public frequency bandwidths. The proposed hybrid DECT-2020 NR and Wi-Fi solution significantly improves reliability, security, and communication efficiency, positioning it as a robust candidate for next-generation IoT communication systems.},
	number = {15},
	urldate = {2026-07-08},
	journal = {IEEE Internet of Things Journal},
	author = {Dang, Yongchao and Quang, Ngo and Roni, Fagerholm and Veli-Matti, Rantanen and Kalle, Ruttik and Jäntti, Riku},
	month = aug,
	year = {2025},
	keywords = {Reliability, Standards, Wireless communication, Wireless sensor networks, Internet of Things, Bandwidth, Wireless fidelity, DECT-2020, Data communication, Authentication, Communication system security, digital enhanced cordless telecommunications (DECT), enhanced wireless direct connectivity (EWDC), wireless direct communication},
	pages = {31783--31796},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/TG24XK5V/Dang et al. - 2025 - EWDC Integrating DECT-2020 With Wi-Fi for Enhanced Wireless Direct Connectivity.pdf:application/pdf},
}

@inproceedings{ngo_demo_2025,
	title = {Demo: {Toward} {Multi}-{Connectivity} {6G} {IoT} - {Practical} {IoT} {Device}-to-{Core} {Integration}},
	shorttitle = {Demo},
	url = {https://ieeexplore.ieee.org/document/11314146/},
	doi = {10.1109/6GNet68413.2025.11314146},
	abstract = {The emerging 6G vision aims to enable massive IoT deployments, multi-connectivity, and heterogeneous networks while ensuring ultra-reliable low-latency communications, robust security, and intelligent network orchestration. Current approaches to IoT connectivity remain fragmented and isolated, lacking seamless interoperability and exposing gaps in end-to-end security. To address these gaps, we present a lightweight implementation for direct authentication and registration of IoT UEs with a commercial 5G Core (5GC) using Raspberry Pi 5 devices over Wi-Fi, enabling 5G-AKA authentication and secured NAS channel. Our implementation aims to provide a ready-to-use solution that can expand to other wireless standards, aligning with the 6G vision and emerging IoT standards such as DECT NR+. By offloading authentication, session management, and traffic control to the 5GC, resource-constrained IoT devices gain access to carrier-grade security and efficient traffic handling. Furthermore, we demonstrate a secured data-plane setup in which WireGuard configuration is exchanged between two UEs through the gNB, establishing an encrypted VPN tunnel. Validation through Wireshark captures and the 5GC GUI confirms compliance with 3 GPP specifications. This work provides a practical step toward 6G IoT integration, offering a scalable, secure, and multi-connectivity-ready solution for industrial and enterprise deployments.},
	urldate = {2026-07-08},
	booktitle = {2025 4th {International} {Conference} on {6G} {Networking} ({6GNet})},
	author = {Ngo, Quang Quoc and Kalle, Ruttik and Yongchao, Dang and Riku, Jäntti and Costa-Requena, Jose},
	month = dec,
