	keywords = {5G, 5G mobile communication, Ultra reliable low latency communication, 6G, Standards, Wireless communication, Internet of Things, 6G mobile communication, Security, Heterogeneous networks, Wireless fidelity, Virtual private networks, IoT, Authentication, Heterogeneous Networks, Multi-Connectivity},
