	pages = {31--34},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/LSJGWZW4/Mudriievskyi et al. - 2024 - CHEAP 5G DECT NR+ for Tactile Internet With Human In The Loop Application.pdf:application/pdf},
}

