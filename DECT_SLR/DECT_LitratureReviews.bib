@article{khalili_bridging_nodate,
	title = {Bridging {Light} and {Radio}: {Hybrid} {Network} {Architectures} for {IoT} in the {6G} {Era}},
	volume = {2025},
	shorttitle = {Bridging {Light} and {Radio}},
	url = {https://www.techrxiv.org/doi/full/10.36227/techrxiv.176462964.43051246/v1},
	doi = {10.36227/techrxiv.176462964.43051246/v1},
	abstract = {The massive scale and dense deployments of future Internet of Things (IoT), particularly within the 6G framework, expose the critical limitations of traditional Radio Frequency (RF) systems, namely spectral congestion, interference, and security vulnerabilities. Optical Wireless Communication (OWC) offers a compelling complement, providing vast, unlicensed spectrum, immunity to RF interference, and enhanced physical-layer security. However, OWC's susceptibility to blockages and limited mobility hinders its standalone deployment, as it cannot, on its own, meet the stringent connectivity and mobility requirements of many IoT applications. This article explores the convergence of optical and radio networks and proposes a flexible, adaptable, and resilient connectivity framework tailored for modern IoT ecosystems. We present a holistic system architecture that integrates single-mode RF, single-mode OWC, and unified hybrid Access Points (APs) to efficiently manage the diverse and often conflicting objectives of various IoT applications. While these hybrid RF/OWC APs offer significant advantages in cost, efficiency, and coordinated management, they also introduce a primary deployment challenge: the inherent coverage mismatch between the two technologies. To precisely address this critical issue, we demonstrate a practical solution supported by a coverage equivalence analysis to validate the proposed framework. This analysis quantifies the required OWC transmitter density to match a given RF range, offering tangible guidance for system planning.},
	number = {1201},
	urldate = {2026-07-08},
	journal = {TechRxiv},
	publisher = {TechRxiv},
	author = {Khalili, Mohammad and Perera, Amila and Häkkinen, Juha and Katz, Marcos and Mikhaylov, Konstantin},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/RBCWNIZD/Khalili et al. - Bridging Light and Radio Hybrid Network Architectures for IoT in the 6G Era.pdf:application/pdf},
}

@book{anttonen_enabling_2021,
	series = {{VTT} {Research} {Report}},
	title = {Enabling {Massive} {Machine} {Type} {Communications} with {DECT}-2020 {Standard}: {A} {System}-{Level} {Performance} {Study}},
	shorttitle = {Enabling {Massive} {Machine} {Type} {Communications} with {DECT}-2020 {Standard}},
	abstract = {The goal of this research report is to objectively evaluate the performance of emerging DECT-2020 standard. The DECT-2020 standard from European Telecommunications Standards Institute (ETSI) is a candidate technology for International Mobile Telecommunications 2020 (IMT-2020) wireless technology. The target use scenario involves the massive machine type communications (mMTC) in an urban macro wireless channel environment. The International Telecommunication Union (ITU) sets the requirements for any IMT-compliant mMTC technology. Essentially, the supported device connection density must be at least 1 million devices per km2 while the packet outage rate and packet delay must be at most 1 \% and 10 s, respectively.

The used simulation environment is developed using the well-recognized Network Simulator 3 (NS-3) software in order to estimate the packet outage rate constrained by the packet delay and network density. The comprehensive system simulator can handle both the device association phase as well as the application data transmission phase according to the DECT-2020 standard specifications. A distinctive system parameter of interest is the proportion of routing devices out of all source devices in the mesh network.

It is concluded that, for the given evaluation framework, the DECT-2020 is able to fulfil the aforementioned ITU requirements and it appears, therefore, a potential candidate for the IMT-2020-enabled mMTC digital services. During the project, VTT’s results also contributed to the ETSI evaluation group work and were used in corresponding interim evaluation report submitted to ITU-R by ETSI.

The views and results of this report are those of authors.},
	publisher = {VTT Technical Research Centre of Finland},
	author = {Anttonen, Antti and Karhula, Pekka and Lasanen, Mika and Majanen, Mikko},
	year = {2021},
	keywords = {DECT-2020, ITU requirements, massive machine type communications, packet outage rate, system simulations},
	annote = {VTT-R-00367-21 (lisätty tiedosto Antti Anttosen pyynnöstä),128181/SySimD2020},
}

