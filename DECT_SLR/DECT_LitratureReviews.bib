	note = {ISSN: 2577-2465},
	keywords = {5G mobile communication, Topology, Analytical models, algorithms, mMTC, New Radio, Relays, IoT, DECT-2020, multi-hop, Power control, Vehicular and wireless technologies, Energy conservation, topology},
	pages = {1--6},
