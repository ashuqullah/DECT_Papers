	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/BVPMF7SZ/Graf et al. - 2026 - A Pareto Optimality Approach for Link Adaptation in DECT NR+.pdf:application/pdf},
}

@inproceedings{samuylov_performance_2024,
	title = {Performance of {MAC} {Layer} {Mechanisms} in {DECT}-2020 {NR} {mMTC} {Technology}},
	issn = {2577-2465},
	url = {https://ieeexplore.ieee.org/document/10683658/},
	doi = {10.1109/VTC2024-Spring62846.2024.10683658},
	abstract = {DECT-2020 is a recently standardized enabling technology for 5G massive machine-type communications operating in the unlicensed band. By relying upon multi-hop communications, DECT-2020 allows for cost-controlled flexible deployments, it requires an efficient solution for topology design, including the relay selection and next-hop selection mechanisms. The goal of this paper is to evaluate the impact of these algorithms on the fraction of successfully delivered packets for DECT-2020 technology. To this aim, we utilize the system-level simulation tool to capture the functionality of the physical and data-link DECT-2020 solutions. Our numerical results illustrate that the system is susceptible to the choice of the energy conservation parameters with the difference in the fraction of delivered packets reaching 10\% and may effectively lead to non-operational conditions. Without simple analytical models, these parameters must be set with caution. The relay-selection mechanism procedure is generally insensitive to the parameters of the relay selection procedure, resulting in a deviation of at most 3\%. Finally, the power control feature gives an additional gain of around 2-4\% compared to the system without power control.},
	urldate = {2026-07-09},
	booktitle = {2024 {IEEE} 99th {Vehicular} {Technology} {Conference} ({VTC2024}-{Spring})},
	author = {Samuylov, Andrey and Moltchanov, Dmitri and Alam, Mirza and Pirskanen, Juho and Numminen, Jussi and Valkama, Mikko and Koucheryavy, Yevgeni and Valkama, Mikko},
	month = jun,
