	urldate = {2026-03-24},
	journal = {IEEE Communications Magazine},
	author = {Samuylov, Andrey and Moltchanov, Dmitri and Gaydamaka, Anna and Lyczkowski, Eike and Frotzscher, Andreas and Von Schoettler, Frank and Pirskanen, Juho and Numminen, Jussi and Salokannel, Juha and Llaguno, Endika and Pires, Rafael and Bayar, Dilara and Valkama, Mikko},
	month = apr,
	year = {2025},
	keywords = {5G mobile communication, Protocols, Throughput, Reliability, Ultra reliable low latency communication, Standards, Interference, Cellular networks, Spread spectrum communication, Distance measurement},
	pages = {130--136},
	file = {PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/NAFLSULZ/Samuylov et al. - 2025 - Empowering Near-URLLC IoT with 5G DECT-2020 NR Current State and the Road Ahead.pdf:application/pdf},
}

@inproceedings{liao_data_2025,
	address = {Surrey, United Kingdom},
	title = {Data {Assisted} {Backscatter} {Communications} {Using} {DECT}-2020 {NR}+ as {Ambient} {Signal}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {978-1-6654-7776-5},
	url = {https://ieeexplore.ieee.org/document/11143257/},
	doi = {10.1109/SPAWC66079.2025.11143257},
	abstract = {The Digital Enhanced Cordless Telecommunications (DECT-2020) New Radio (NR+), standardized by the European Telecommunications Standards Institute (ETSI), addresses International Telecommunication Union (ITU) IMT-2020 requirements for Internet of Things (IoT) and Industrial IoT. Although DECT2020 NR+ offers robust connectivity, it does not support ultra-low power or batteryless operation. The 3rd Generation Partnership Project’s (3GPP’s) Ambient Internet of Things (AIoT) initiative targets ultra-low power IoT devices operating on harvested ambient energy, with backscatter communication as a promising technology. This paper integrates backscatter-based AIoT functionality into DECT networks, leveraging existing DECT transmissions and data-assisted channel estimation to recover backscattered information. An Ambient Backscatter Communication (AmBC) receiver is symbiotically embedded within the DECT receiver, using Received Signal Strength (RSS) of DECT data traffic. We open-sourced the Matlab code for the DECT receiver in a Software-Defined Radio (SDR) platform. Over-theair experiments demonstrate feasibility, achieving Bit Error Rate (BER) performance as low as 0.02 under optimal conditions.},
	language = {en},
	urldate = {2026-03-24},
	booktitle = {2025 {IEEE} 26th {International} {Workshop} on {Signal} {Processing} and {Artificial} {Intelligence} for {Wireless} {Communications} ({SPAWC})},
