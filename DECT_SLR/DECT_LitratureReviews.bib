@misc{dang_uni-rat_2026,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Uni-{RAT}: {A} {Unified} {DECT}-2020 {NR} and {Wi}-{Fi} {System} for {6G} {Multi}-{RAT} {Networks}},
	shorttitle = {Uni-{RAT}},
	url = {https://papers.ssrn.com/abstract=6459430},
	doi = {10.2139/ssrn.6459430},
	abstract = {Future 6G networks aim to deliver seamless, secure, and low-latency connectivity across heterogeneous radio access technologies (RATs) such as 5G New Radio (NR), Wi-Fi, and DECT-2020 NR to support emerging applications including extended reality (XR) and the Industrial Internet of Things (IIoT). However, current Multi-RATs systems are operated and managed in isolation, which hinders users and devices from seamlessly leveraging heterogeneous connectivity in a unified and efficient manner. To address this fragmentation, 3GPP has introduced interworking functions such as the N3IWF for untrusted and the TNGF for trusted non-3GPP access, enabling IP-session continuity when users move across heterogeneous networks. Nevertheless, these mechanisms rely on mandatory IPsec, which requires each RAT to maintain a separate secure tunnel to the core network and prevents intra-cell device-to-device (D2D) communication, thereby introducing significant encryption latency, increasing data-plane load, and complicating network management. To overcome these limitations, we propose Uni-RAT, a unified Multi-RATs framework in which DECT-2020 NR operates as the Master-RAT, anchoring 3GPP control-plane security via 5G-AKA and NAS, while Wi-Fi functions as a Secondary-RAT for data-plane data delivery. Uni-RAT employs lightweight Layer-3 WireGuard tunnels to secure both D2D and multi-hop communication, significantly reducing the latency and computational overhead of IPsec-based interworking mechanisms used by N3IWF and TNGF. In addition, a customized SMS-over-NAS signaling mechanism is introduced to distribute WireGuard configuration and keying material, enabling unified authentication and efficient Multi-RATs security management. We implement a full prototype using Nordic nRF9161 DECT-2020 NR devices, Raspberry Pi Wi-Fi nodes, and a Cumucore 5G core, with security-critical functions protected inside Arm TrustZone. Experimental results indicate that Uni-RAT supports Multi-RATs communication with high throughput and low packet loss in intra-cell D2D scenarios, maintains bounded latency and jitter under relay-assisted and inter-cell configurations, and achieves stable UE registration latency below 100 ms with up to 100 concurrent devices under background traffic, demonstrating its practical feasibility and scalability and positioning Uni-RAT as an early architectural blueprint for 6G Multi-RATs networks.},
	language = {en},
	urldate = {2026-07-08},
	publisher = {Social Science Research Network},
	author = {Dang, Yongchao and Quang, Ngo and Kalle, Ruttik and Requena, Jose Costa and Jäntt, Rikui},
	month = mar,
	year = {2026},
	keywords = {DECT-2020 NR, Wi-Fi, 6G., Device-to-Device (D2D), Multi-RATs, SMS-over-NAS},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/4EWB29NA/Dang et al. - 2026 - Uni-RAT A Unified DECT-2020 NR and Wi-Fi System for 6G Multi-RAT Networks.pdf:application/pdf},
}

@article{fagerholm_fpga-based_2024,
	title = {{FPGA}-based {DECT}-2020 {New} {Radio} packet detection},
	url = {https://aaltodoc.aalto.fi/handle/123456789/131768},
	abstract = {A rapid increase in number and diverse applications of connected devices has forced digital wireless protocols to specialize further for specific purposes. One of such applications is the previously unanswered market for reliable wireless low-latency communication in private self-sustained networks. As a revision of an older standard, DECT-2020 New Radio aims to provide a solution for this market. To research different physical layer properties of DECT in real-world environments, a software-defined radio (SDR) framework would be required. Since such design already existing for IEEE 802.11, a well-utilized open-source project openwifi, an analogous solution for DECT could be realized. The goal of this thesis was to provide an implementation for the first part of this SDR framework. The main contribution of this thesis is an FPGA-based packet detector for DECT. Written in Verilog-2001 for an AMD Zynq system-on-chip, the implemented design manages Synchronization Training Field preamble detection and timing synchronization with hardware efficient autocorrelation approach. The proposed design was evaluated using a simulation environment that integrated MATLAB and the Icarus Verilog simulation tool. Both real-world and generated data were utilized during the simulation. Compared to a cross-correlation based detection, the implementation utilizes only two complex-valued multiplications at the expense of a higher signal-to-noise (SNR) ratio requirement. In comparison to a reference autocorrelation-based detection, the implementation requires at least 2.6 dB higher SNR depending on the utilized configuration, yet it does not suffer from co-channel interference and includes a simpler signal power estimator. The resource utilization of the proposed design is comparable to that of openwifi despite differences in communication protocols. Finally, different power scaling factors were simulated to analyze the implementation’s performance. The thesis thus provides an initial foundation to a hardware-based SDR for DECT-2020 NR.},
	language = {en},
	urldate = {2026-07-08},
	author = {Fagerholm, Roni},
	month = sep,
	year = {2024},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/VAUTRWTF/Fagerholm - 2024 - FPGA-based DECT-2020 New Radio packet detection.pdf:application/pdf},
}

