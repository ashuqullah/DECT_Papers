@misc{fedrecheski_mari_2026,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Mari: {Responsive} {Wireless} {Communication} for {Low}-{Power} {Large}-{Scale} {Robot} {Swarms}},
	shorttitle = {Mari},
	url = {https://papers.ssrn.com/abstract=6571600},
	doi = {10.2139/ssrn.6571600},
	abstract = {Connecting large swarms of low-power micro-robots remains an open challenge: existing communication systems either lack the scalability to connect hundreds of units, or fail to deliver the low latency required for responsive control. For example, while Wi-Fi and BLE are commonly used in swarm robotics, scaling beyond 50 robots remains challenging. We introduce the Micro-robot Access Radio Infrastructure (Mari), a new link layer and architecture that aims to connect thousands of robots. Our TSCH-based link layer runs on commodity BLE radios, providing responsive control of up to 102 nodes using a single gateway. To scale beyond a single gateway, Mari supports multiple non-coordinated gateways with fast node-controlled handovers. We further provide a lightweight infrastructure for real-time remote control and monitoring. We implement Mari on the popular nRF52840 and nRF5340 platforms, and extensively evaluate it in large-scale testbeds. In experiments with 100 nodes connected to a single gateway, Mari achieves a packet delivery ratio above 97\%, round-trip latency of 269 ms, and full association time of 3.5 s under a join storm. When moving 100 nodes together between two gateways, we obtain an average handover duration of only 0.34 s. A single node handover time can take less than 50 ms. In a setup with 200 nodes and two gateways, we measure round-trip latency of 274 ms and a packet delivery ratio above 93\%. We integrate Mari with the DotBot testbed in an experimental deployment of several hundred robots, enabling remote firmware update of 600 robots in less than 4 min. We contribute Mari as an open-source platform, including firmware, libraries, and performance monitoring tools, enabling researchers to connect swarm systems from a handful of units up to hundreds.},
	language = {en},
	urldate = {2026-07-08},
	publisher = {Social Science Research Network},
	author = {Fedrecheski, Geovane and Gao, Yinghao and Maksimovic, Filip and Abadie, Alexandre and Vučinić, Mališa and Chang, Tengfei and Watteyne, Thomas},
	month = apr,
	year = {2026},
	keywords = {BLE, networking, swarm robotics, Testbeds, TSCH},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/T63IF4YL/Fedrecheski et al. - 2026 - Mari Responsive Wireless Communication for Low-Power Large-Scale Robot Swarms.pdf:application/pdf},
}

@article{atiq_when_2022,
	title = {When {IEEE} 802.11 and {5G} {Meet} {Time}-{Sensitive} {Networking}},
	volume = {3},
	issn = {2644-1284},
	url = {https://ieeexplore.ieee.org/document/9652097/},
	doi = {10.1109/OJIES.2021.3135524},
	abstract = {Many emerging applications require a higher level of flexibility, modularity, and efficiency but are dependent on advancements in communication infrastructure and distributed computing. Time-sensitive networking (TSN) standards aim at providing vendor agnostic, reliable, and deterministic communications over the Ethernet, but lack in flexibility and modularity provisions. In this context wireless communication systems are preferred given the obvious benefits in terms of increased flexibility, reduced deployment \& maintenance costs, and inherent mobility support. However, the stochastic nature of the wireless medium poses several challenges in achieving these benefits. In this paper we comprehensively analyze the recent standardization efforts and developments in IEEE 802.11 and 5G to enable low-latency, deterministic communications and present the current status of their integration with wired TSN. Then, we present a set of use cases that may be enabled by wireless TSN including industrial automation, automotive, or audiovisual applications.},
	urldate = {2026-07-08},
	journal = {IEEE Open Journal of the Industrial Electronics Society},
	author = {Atiq, Mahin K. and Muzaffar, Raheeb and Seijo, Óscar and Val, Iñaki and Bernhard, Hans-Peter},
	year = {2022},
	keywords = {5G, 5G mobile communication, Protocols, Reliability, Standards, Wireless communication, Wireless sensor networks, Wireless fidelity, IEEE 802.11, IEEE 802.11 Standard, deterministic, Real time, reliable, Sensitivity analysis, time sensitive networking, TSN, Wi-Fi},
	pages = {14--36},
	file = {Full Text PDF:/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/AXFYS4U8/Atiq et al. - 2022 - When IEEE 802.11 and 5G Meet Time-Sensitive Networking.pdf:application/pdf},
}

