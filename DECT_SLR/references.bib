@inproceedings{mudriievskyiCHEAP5GDECT2024a,
  title = {{{CHEAP 5G}}: {{DECT NR}}+ for {{Tactile Internet With Human In The Loop Application}}},
  shorttitle = {{{CHEAP 5G}}},
  booktitle = {Eur. {{Wirel}}. 2024 29th {{Eur}}. {{Wirel}}. {{Conf}}.},
  author = {Mudriievskyi, Stanislav and Fitzek, Frank H.P. and Seeling, Patrick},
  year = 2024,
  month = sep,
  pages = {31--34},
  urldate = {2026-07-09},
  abstract = {5G communication networks are suitable to realize Tactile Internet with Human in the Loop application due to the envisaged latency promises. Currently, 5G Release 15 is widely deployed. Latency performance to control robots or enable humans to engage with the metaverse will require higher releases. WiFi is widely used due to its cost, but has poor latency performance due to the ``listen-before-talk'' requirement in the ISM bands. Therefore, solutions that combine low cost and high latency performance are needed. This paper presents a detailed performance evaluation of a 5G DECT NR+ testbed with a focus on latency and data rate. While commercial off-the-shelf (COTS) 5G testbeds are still very expensive, we present a low-cost solution to achieve similar or even better latency performance with NR+. The testbed is composed of two NR+ platforms and will explore different settings such as packet length and Modulation and Coding Scheme (MCS). The main result of the paper is that non-optimized COTS DECT NR+ can provide latency values of 2 ms to 8 ms and a data rate of 2.3 Mbit/s to 2.5 Mbit/s.},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/LSJGWZW4/Mudriievskyi et al. - 2024 - CHEAP 5G DECT NR+ for Tactile Internet With Human In The Loop Application.pdf}
}

@inproceedings{ngoDemoMultiConnectivity6G2025,
  title = {Demo: {{Toward Multi-Connectivity 6G IoT}} - {{Practical IoT Device-to-Core Integration}}},
  shorttitle = {Demo},
  booktitle = {2025 4th {{Int}}. {{Conf}}. {{6G Netw}}. {{6GNet}}},
  author = {Ngo, Quang Quoc and Kalle, Ruttik and Yongchao, Dang and Riku, J{\"a}ntti and {Costa-Requena}, Jose},
  year = 2025,
  month = dec,
  pages = {103--105},
  doi = {10.1109/6GNet68413.2025.11314146},
  urldate = {2026-07-08},
  abstract = {The emerging 6G vision aims to enable massive IoT deployments, multi-connectivity, and heterogeneous networks while ensuring ultra-reliable low-latency communications, robust security, and intelligent network orchestration. Current approaches to IoT connectivity remain fragmented and isolated, lacking seamless interoperability and exposing gaps in end-to-end security. To address these gaps, we present a lightweight implementation for direct authentication and registration of IoT UEs with a commercial 5G Core (5GC) using Raspberry Pi 5 devices over Wi-Fi, enabling 5G-AKA authentication and secured NAS channel. Our implementation aims to provide a ready-to-use solution that can expand to other wireless standards, aligning with the 6G vision and emerging IoT standards such as DECT NR+. By offloading authentication, session management, and traffic control to the 5GC, resource-constrained IoT devices gain access to carrier-grade security and efficient traffic handling. Furthermore, we demonstrate a secured data-plane setup in which WireGuard configuration is exchanged between two UEs through the gNB, establishing an encrypted VPN tunnel. Validation through Wireshark captures and the 5GC GUI confirms compliance with 3 GPP specifications. This work provides a practical step toward 6G IoT integration, offering a scalable, secure, and multi-connectivity-ready solution for industrial and enterprise deployments.},
  keywords = {5G,5G mobile communication,6G,6G mobile communication,Authentication,Heterogeneous networks,Heterogeneous Networks,Internet of Things,IoT,Multi-Connectivity,Security,Standards,Ultra reliable low latency communication,Virtual private networks,Wireless communication,Wireless fidelity},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/C4AIU2Z8/105032197467.html}
}

@article{ngoIoTDeviceAuthentication2025,
  title = {{{IoT}} Device Authentication in {{5G}} Networks},
  author = {Ngo, Quang},
  year = 2025,
  month = dec,
  urldate = {2026-07-08},
  abstract = {The rapid expansion of the Internet of Things and Industrial IoT has accelerated the adoption of distributed sensing, automation, and data-driven decision-making across critical sectors such as manufacturing, energy, healthcare, and logistics. IoT devices typically possess limited computational resources, heterogeneous hardware architectures, and diverse communication protocols, making secure and scalable integration into modern communication infrastructures a persistent challenge. Although 5G provides high reliability, ultra-low latency, and massive connectivity---factors which makes it a promising foundation for IoT systems---current integration approaches often rely on complex architectures, proprietary gateways, and heavyweight security frameworks that limit their practicality in resource-constrained and industrial environments. To address these limitations, this thesis presents a lightweight and interoperable IoT-to-5G integration framework featuring a minimal User Equipment and gNB gateway stack implemented in C. The system can operate directly on embedded IoT devices such as Raspberry Pi and non-cellular IIoT platforms like DECT-2020 NR, e.g. Nordic Semiconductor nRF91 family. Moreover, the UE and gNB gateways are designed to connect seamlessly with the private 5G Core Networks for device authentication, enabling secure, scalable, and standards-compliant integration across heterogeneous IoT environments. Experimental validation demonstrates that the designed UE and gNB gateway interoperate seamlessly with both commercial and open-source 5G systems, including Cumucore, OpenAirInterface, and free5GC. Unlike traditional IoT gateways that locally handle protocol translation and security overhead, the proposed design offloads authentication, session management, and traffic control directly to the 5GC, thereby reducing the computational burden on edge IoT and IIoT devices while ensuring full compliance with 3GPP standards.},
  langid = {english},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/5VN7G2ES/Ngo - 2025 - IoT device authentication in 5G networks.pdf}
}

@incollection{nguyenNetworkNetworksTactile2026,
  title = {Network of Networks for the {{Tactile Internet}}},
  booktitle = {Humans, {{Robots}} and {{Virtual Worlds}} in the {{Tactile Internet}}},
  author = {Nguyen, Giang T. and H{\"o}schele, Thomas and Itting, Sebastian A.W. and Kangavar Nazari, Hosein and Senk, Stefan and Scheinert, Tobias and Liu, How-Hang and Ulbricht, Marian and Mudriievskyi, Stanislav and Zhang, Jiajing and Sridharan, Shreeja and Krzywinski, Jens and P{\"o}tter, Max A. and Fitzek, Frank H.P. and G{\"u}le{\c c}y{\"u}z, Ba{\c s}ak and Steinbach, Eckehard},
  editor = {Fitzek, Frank H.P. and Li, Shu-Chen and Speidel, Stefanie and Strufe, Thorsten and Mahmoodi, Toktam and Reisslein, Martin},
  year = 2026,
  pages = {167--186},
  publisher = {Elsevier},
  doi = {10.1016/B978-0-44-330044-8.00023-3},
  abstract = {This chapter delves into the architecture and interconnection of networked systems in the Tactile Internet, emphasising their crucial role in supporting human-machine interactions. It goes beyond conventional network areas (LAN/MAN/WAN) and expands into non-terrestrial networks. The chapter focuses on two critical aspects: (i) service differentiation, which involves network slicing to support multiple sensory modalities and (ii) determinism, achieved through time-sensitive networks for safety-critical applications. Wireless connections enabled by qualified technologies, such as 5G, lay the foundation. By exploring these aspects, the chapter showcases how the Tactile Internet network of networks is designed to provide low-latency, reliable, and differentiated services to enable seamless human-machine interactions. \copyright{} 2026 Elsevier Inc. All rights reserved.},
  isbn = {978-0-443-30044-8},
  langid = {english},
  keywords = {5G/6G campus networks,DECT NR+,non-terrestrial networks,time-sensitive networks}
}

