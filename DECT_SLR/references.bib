  urldate = {2026-07-14},
  abstract = {Hyperbolic fractional Fourier transform (HFrFT) as a generalized form of fractional Fourier transform (FrFT), based on the utilization of complex transform orders, is intro-duced. Then, the performance improvement of IEEE 802.11bd based on HFrFT -orthogonal frequency division multiplexing (OFDM) is presented. This paper defines continuous hyper-bolic fractional Fourier transform (CHFrFT). Furthermore, a closed form of discrete hyperbolic fractional Fourier transform (DHFrFT) is mathematically derived. The proposed idea shows in high-speed conditions with a high rate of carrier frequency offset (CFO) the bit error rate (BER) performance of IEEE 802.11bd based on HFrFT is significantly improved.},
