  abstract = {The Digital Enhanced Cordless Telecommunications (DECT-2020) New Radio (NR+), standardized by the European Telecommunications Standards Institute (ETSI), addresses International Telecommunication Union (ITU) IMT-2020 requirements for Internet of Things (IoT) and Industrial IoT. Although DECT2020 NR+ offers robust connectivity, it does not support ultra-low power or batteryless operation. The 3rd Generation Partnership Project's (3GPP's) Ambient Internet of Things (AIoT) initiative targets ultra-low power IoT devices operating on harvested ambient energy, with backscatter communication as a promising technology. This paper integrates backscatter-based AIoT functionality into DECT networks, leveraging existing DECT transmissions and data-assisted channel estimation to recover backscattered information. An Ambient Backscatter Communication (AmBC) receiver is symbiotically embedded within the DECT receiver, using Received Signal Strength (RSS) of DECT data traffic. We open-sourced the Matlab code for the DECT receiver in a Software-Defined Radio (SDR) platform. Over-theair experiments demonstrate feasibility, achieving Bit Error Rate (BER) performance as low as 0.02 under optimal conditions.},
  copyright = {https://doi.org/10.15223/policy-029},
  isbn = {978-1-6654-7776-5},
  langid = {english},
  keywords = {Ambient Backscatter Communications,Artificial intelligence,Backscatter,Bit error rate,Digital Enhanced Cordless Telecommunication,Internet of Things,Low power electronics,Open-source Software,Performance evaluation,Received Signal Strength,Receivers,Software radio,Software-Defined Radio,Telecommunications,Wireless networks},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/JKDD6I2G/Liao et al. - 2025 - Data Assisted Backscatter Communications Using DECT-2020 NR+ as Ambient Signal.pdf}
}

@inproceedings{liuDataAidedChannelEstimation2025,
  title = {Data-{{Aided Channel Estimation}} for {{Robust DECT-2020 NR}}+ {{Links}} in {{Oil}} and {{Gas Equipment Data Communication}}},
  booktitle = {2025 7th {{Int}}. {{Conf}}. {{Intell}}. {{Control Meas}}. {{Signal Process}}. {{ICMSP}}},
  author = {Liu, Zheyuan and Li, Qian and Yang, Shuangye and Yao, Chenyang and Zhao, Kai and Jia, Lufeng and Zhang, Qiao and Guo, Biao},
  year = 2025,
  month = nov,
  pages = {309--313},
  doi = {10.1109/ICMSP68723.2025.11407711},
  urldate = {2026-07-08},
  abstract = {Oil and gas extraction and processing environments impose stringent requirements on wireless data links used for equipment monitoring, control, and safety. Multipath-rich metallic structures, Radio Frequency(RF) blocking, and dynamic interference degrade channel estimation accuracy, especially at low SNR. This paper adapts and evaluates a data-aided least-squares (LS) channel estimation approach---originally developed and validated for Digital Enhancement Cordless Telecommunication2020 New Radio Plus(DECT-2020 NR+)---to oil and gas equipment data communication over Orthogonal Frequency Division Multiplexing(OFDM) links. By combining pilot symbols with previously decoded data symbols, the proposed receiver improves channel transfer function (CTF) estimates without increasing pilot overhead. MATLAB simulations on AWGN and 3GPP TDL channels, coupled with a lab validation using a DECT development board and a backscatter-like test signal, show consistent MSE gains over pilot-only LS across SNRs. Deployment aspects for oil and gas sites, including subcarrier numerology, packetization, and frequency planning in the 1.9 GHz frequency band, which is used in some industrial wireless systems. Detailed implementation guidance is provided for field gateways and sensor Radio Devices(RDs). Results indicate that data-aided estimation enhances reliability and spectral efficiency for real-time equipment telemetry and alarm reporting in harsh oilfield environments.},
  keywords = {Channel estimation,Channel Estimation,Data-aided,Decision-Directed Channel Estimation,DECT-2020 NR+,Industrial IoT,LS,OFDM,Oil and Gas Equipment,Oils,Receivers,Safety,Signal to noise ratio,Symbols,Telemetry,Transfer functions,Wireless sensor networks},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/EQVWQQPH/Liu et al. - 2025 - Data-Aided Channel Estimation for Robust DECT-2020 NR+ Links in Oil and Gas Equipment Data Communica.pdf}
}

@article{liuEfficientResourceAllocation2024,
  title = {Efficient Resource Allocation for {{IoT}} Applications in Mobile Edge Computing via Dynamic Request Scheduling Optimization},
  author = {Liu, Jun and Li, Chunlin and Luo, Youlong},
  year = 2024,
  month = dec,
  journal = {Expert Syst. Appl.},
  volume = {255},
  pages = {124716},
  issn = {0957-4174},
  doi = {10.1016/j.eswa.2024.124716},
  urldate = {2026-07-14},
  abstract = {This study investigates the challenges of task scheduling and resource allocation in an ultra-dense edge cloud (UDEC) network incorporating micro (macro) base stations and different equipment users (UE) under 5G technology. By utilizing multiple access interference (MAI), we enable multiple access capabilities to the UEs under the Non-Orthogonal Multiple Access (NOMA) protocol. To accommodate the dynamic nature of user tasks, we propose a two-level scheduling framework. At the upper level, the non-convex, non-linear power allocation problem for mobile users is formulated and solved using the Inertia Weight Particle Swarm Optimization (IW-PSO) algorithm to minimize the transmission energy consumption. Simultaneously, at the lower level, the joint task offloading and resource allocation problem is formulated as MINP and solved with the binary Particle Swarm Optimization (PSO) algorithm to find an optimal schedule that maximizes the response rate and the overall welfare of the system while minimizing the energy consumption. In this study, various sensitivity analyses are conducted for different parameters, including the number of mobile users, channel power, and request profile parameters, including workload and request size. Comparative analyses with other methods from recent literature consistently reveal the comparable performance of the proposed framework and confirm its effectiveness in addressing the challenges of dynamic task scheduling.},
  keywords = {Dynamic task allocation,Internet of things,Mobile edge computing,Ultra dense network},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/TPKRF7KZ/Liu et al. - 2024 - Efficient resource allocation for IoT applications in mobile edge computing via dynamic request sche.pdf;/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/TYA2NWJ3/S0957417424015835.html}
}

@article{liuOpportunisticTransmissionScheduling2001,
