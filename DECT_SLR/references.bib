}

@inproceedings{guillaumeSecretKeyGeneration2015,
  title = {Secret Key Generation from Static Channels with Untrusted Relays},
  booktitle = {2015 {{IEEE}} 11th {{Int}}. {{Conf}}. {{Wirel}}. {{Mob}}. {{Comput}}. {{Netw}}. {{Commun}}. {{WiMob}}},
  author = {Guillaume, Ren{\'e} and Ludwig, Stephan and M{\"u}ller, Andreas and Czylwik, Andreas},
  year = 2015,
  month = oct,
  pages = {635--642},
  doi = {10.1109/WiMOB.2015.7348022},
  urldate = {2026-07-14},
  abstract = {The generation of symmetric cryptographic keys based on reciprocal channel properties has evolved as a promising approach in recent years, especially for devices with only little computational power. Different schemes individually addressing constraints from special setups have been proposed, but most schemes generally suffer from bad performance in case of (nearly) static scenarios. Addressing this dilemma, we present a novel approach for physical layer based key generation with two static users supported by a third party. In contrast to other solutions, this approach does not rely on special hardware like multiple antennas and does not let the third party know anything about the secret key, as the helper is potentially not fully trusted. The scheme does not evade to other diversity domains, but still exploits temporal and spatial diversity. We present thorough performance and security analysis, also taking a passive attacker into account.},
  keywords = {Communication system security,Conferences,Hardware,Protocols,Relays,Wireless communication,Wireless sensor networks},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/5J46PHPQ/Guillaume et al. - 2015 - Secret key generation from static channels with untrusted relays.pdf}
}

@article{karrenbauerFutureIndustrialNetworking2019a,
  title = {{Future industrial networking: from use cases to wireless technologies to a flexible system architecture}},
  shorttitle = {{Future industrial networking}},
  author = {Karrenbauer, Michael and Ludwig, Stephan and Buhr, Henning and Klessig, Henrik and Bernardy, Anne and Wu, Huanzhuo and Pallasch, Christoph and Fellan, Amina and Hoffmann, Nicolai and Seelmann, Vasco and Taghouti, Maroua and Wunderlich, Simon and Lozano, Pedro Tercero and Hoell, Andreas and Stimming, Christian and Patel, Dhruvin and Seetaraman, Savita and Bender, Serjoscha and Eberhardt, Elena and Schildknecht, Thomas and Herfs, Werner and Storms, Simon and Stich, Volker and Niebert, Norbert and Schotten, Hans D. and Fitzek, Frank H. P.},
