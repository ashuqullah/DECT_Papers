@article{grafWhatExpectWhen2026,
  title = {What to {{Expect When Using DECT NR}}+},
  author = {Graf, Fabian and Watteyne, Thomas and Villnow, Michael},
  year = 2026,
  month = feb,
  journal = {IEEE Commun. Mag.},
  volume = {64},
  number = {2},
  pages = {16--22},
  issn = {0163-6804, 1558-1896},
  doi = {10.1109/MCOM.001.2500286},
  urldate = {2026-03-24},
  abstract = {DECT NR+ is the new kid on the block in wireless technologies: it re-purposes the 1.9 GHz Digital Enhanced Cordless Telecommunications (DECT) standard for IoT-type applications. How does DECT NR+ perform in practice and where should we be using it? The ambition of this article is to provide answers to those questions. We start by an overview of the fundamental principles of the physical layer. We then survey the DECT NR+ products on the market today. Using the nRF91 series from Nordic Semiconductor, we conduct a comprehensive set of hands-on power consumption and communication range measurements. Our results place DECT NR+ in a gap in-between existing technologies. Its range is comparable to long range standards such as IEEE 802.15.4g under certain parameter choices: 200 m in an urban setting, 6 km in the most favorable lineof-sight conditions. For higher order Modulation and Coding Schemes, range drops and is rather comparable to Wi-Fi. The nRF9161 draws significant power (at 3.7 V, 220 mA transmitting at +19 dBm, 45 mA receiving), approximately 10\texttimes{} higher than BLE radios. This is likely primarily due to earlystage design inefficiencies and the inherent complexity of the DECT NR+ physical layer, limiting its adoption in batterypowered applications. We conclude that DECT NR+ is particularly appropriate for applications that require a dynamic tradeoff between communication range and data rate, but are not cost-sensitive.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  keywords = {5G mobile communication,Costs,Internet of Things,OFDM,Physical layer,Power demand,Regulation,Semiconductor device measurement,Standards,Symbols},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/C3XX3PY8/Graf et al. - 2026 - What to Expect When Using DECT NR+.pdf}
}

