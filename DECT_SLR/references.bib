@article{dangEWDCIntegratingDECT20202025a,
  title = {{{EWDC}}: {{Integrating DECT-2020 With Wi-Fi}} for {{Enhanced Wireless Direct Connectivity}}},
  shorttitle = {{{EWDC}}},
  author = {Dang, Yongchao and Quang, Ngo and Roni, Fagerholm and {Veli-Matti}, Rantanen and Kalle, Ruttik and J{\"a}ntti, Riku},
  year = 2025,
  month = aug,
  journal = {IEEE Internet Things J.},
  volume = {12},
  number = {15},
  pages = {31783--31796},
  issn = {2327-4662},
  doi = {10.1109/JIOT.2025.3574407},
  urldate = {2026-07-08},
  abstract = {The rapid growth of smartphones, laptops, and Internet of Things (IoT) devices has created an increasing demand for seamless, secure, and energy-efficient wireless direct communication. Current popular solutions, such as AirDrop and Intel Unison, rely on bluetooth low energy (BLE) for device discovery and pairing, alongside IEEE 802.11 (Wi-Fi) for high-speed data transmission. However, research has identified significant vulnerabilities in BLE, including information leakage and profile manipulation. To address these challenges, we propose an enhanced wireless direct connectivity (EWDC) framework that integrates digital enhanced cordless telecommunications (DECT)-2020 new radio (NR) with Wi-Fi. In this framework, DECT replaces BLE to enable secure and efficient device discovery, while Wi-Fi supports high-bandwidth data transmission. Specifically, DECT utilizes its licensed spectrum to establish a secure communication channel for sharing Wi-Fi configuration information, enabling a secure and reliable setup of high-speed Wi-Fi data transmission links between devices. To validate this approach, we implemented the DECT medium access control layer on the Nordic nRF9161-DK platform and evaluated the end-to-end delay between two devices. Our results demonstrate an impressive transmission delay of less than 1 \textbackslash mu s for EWDC communication, enabling rapid device discovery and highly efficient operation. Furthermore, to enhance the security of wireless direct connections, the WireGuard, a VPN tunnel, is employed to encrypt data transmission over Wi-Fi providing robust protection for data shared on public frequency bandwidths. The proposed hybrid DECT-2020 NR and Wi-Fi solution significantly improves reliability, security, and communication efficiency, positioning it as a robust candidate for next-generation IoT communication systems.},
  keywords = {Authentication,Bandwidth,Communication system security,Data communication,DECT-2020,digital enhanced cordless telecommunications (DECT),enhanced wireless direct connectivity (EWDC),Internet of Things,Reliability,Standards,Wireless communication,wireless direct communication,Wireless fidelity,Wireless sensor networks},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/TG24XK5V/Dang et al. - 2025 - EWDC Integrating DECT-2020 With Wi-Fi for Enhanced Wireless Direct Connectivity.pdf}
}

@article{dangUniRATUnifiedDECT20202026,
  type = {{{SSRN Scholarly Paper}}},
  title = {Uni-{{RAT}}: {{A Unified DECT-2020 NR}} and {{Wi-Fi System}} for {{6G Multi-RAT Networks}}},
  shorttitle = {Uni-{{RAT}}},
  author = {Dang, Yongchao and Quang, Ngo and Kalle, Ruttik and Requena, Jose Costa and J{\"a}ntt, Rikui},
  year = 2026,
  month = mar,
  number = {6459430},
  eprint = {6459430},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.6459430},
  urldate = {2026-07-08},
  abstract = {Future 6G networks aim to deliver seamless, secure, and low-latency connectivity across heterogeneous radio access technologies (RATs) such as 5G New Radio (NR), Wi-Fi, and DECT-2020 NR to support emerging applications including extended reality (XR) and the Industrial Internet of Things (IIoT). However, current Multi-RATs systems are operated and managed in isolation, which hinders users and devices from seamlessly leveraging heterogeneous connectivity in a unified and efficient manner. To address this fragmentation, 3GPP has introduced interworking functions such as the N3IWF for untrusted and the TNGF for trusted non-3GPP access, enabling IP-session continuity when users move across heterogeneous networks. Nevertheless, these mechanisms rely on mandatory IPsec, which requires each RAT to maintain a separate secure tunnel to the core network and prevents intra-cell device-to-device (D2D) communication, thereby introducing significant encryption latency, increasing data-plane load, and complicating network management. To overcome these limitations, we propose Uni-RAT, a unified Multi-RATs framework in which DECT-2020 NR operates as the Master-RAT, anchoring 3GPP control-plane security via 5G-AKA and NAS, while Wi-Fi functions as a Secondary-RAT for data-plane data delivery. Uni-RAT employs lightweight Layer-3 WireGuard tunnels to secure both D2D and multi-hop communication, significantly reducing the latency and computational overhead of IPsec-based interworking mechanisms used by N3IWF and TNGF. In addition, a customized SMS-over-NAS signaling mechanism is introduced to distribute WireGuard configuration and keying material, enabling unified authentication and efficient Multi-RATs security management. We implement a full prototype using Nordic nRF9161 DECT-2020 NR devices, Raspberry Pi Wi-Fi nodes, and a Cumucore 5G core, with security-critical functions protected inside Arm TrustZone. Experimental results indicate that Uni-RAT supports Multi-RATs communication with high throughput and low packet loss in intra-cell D2D scenarios, maintains bounded latency and jitter under relay-assisted and inter-cell configurations, and achieves stable UE registration latency below 100 ms with up to 100 concurrent devices under background traffic, demonstrating its practical feasibility and scalability and positioning Uni-RAT as an early architectural blueprint for 6G Multi-RATs networks.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {6G.,DECT-2020 NR,Device-to-Device (D2D),Multi-RATs,SMS-over-NAS,Wi-Fi},
  file = {/home/ashuqullah-alizai/snap/zotero-snap/common/Zotero/storage/4EWB29NA/Dang et al. - 2026 - Uni-RAT A Unified DECT-2020 NR and Wi-Fi System for 6G Multi-RAT Networks.pdf}
}

