@inproceedings{samuylovPerformanceDECT2020NR2025,
  title = {Performance of {{DECT-2020 NR}} and {{FCC-Based Mesh IoT Systems}} in {{DECT Bands}}},
  booktitle = {2025 {{IEEE}} 101st {{Vehicular Technology Conference}} ({{VTC2025-Spring}})},
  author = {Samuylov, Andrey and others},
  year = 2025,
