  doi = {10.1109/ACCESS.2024.3351234},
  urldate = {2026-03-09},
  abstract = {The emergence of tactile Internet applications and human-in-the-loop control systems requires wireless technologies capable of providing ultra-reliable low-latency communication (URLLC). DECT NR+ has recently emerged as a candidate technology capable of delivering such capabilities in license-exempt spectrum. This work investigates the feasibility of DECT NR+ for latency-critical applications by experimentally evaluating system performance in a realistic deployment scenario. The results demonstrate that DECT NR+ can achieve millisecond-level latency while maintaining high reliability, making it suitable for industrial automation and interactive control systems. The study highlights the potential of DECT NR+ as a cost-effective alternative to traditional cellular deployments for URLLC use cases.},
