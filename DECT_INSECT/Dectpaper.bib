  doi = {10.1109/MCOMSTD.2021.3051234},
  urldate = {2026-03-09},
  abstract = {DECT-2020 New Radio (NR) has been standardized by ETSI as a new radio interface technology targeting massive machine-type communications (mMTC) and ultra-reliable low-latency communications (URLLC). Unlike traditional cellular systems, DECT-2020 NR enables decentralized deployments operating in license-exempt spectrum with flexible network topologies including star and mesh configurations. This article presents an overview of the DECT-2020 NR standard, its architectural design principles, and its suitability for industrial and Internet of Things (IoT) applications. Key enabling technologies such as dynamic spectrum access, distributed scheduling, and flexible frame structures are discussed, highlighting how DECT-2020 NR complements existing 5G technologies and expands wireless connectivity options for large-scale IoT deployments.},
  keywords = {DECT-2020 NR,5G,mMTC,URLLC,Industrial IoT,Wireless communication standards,Machine-type communications}
}
